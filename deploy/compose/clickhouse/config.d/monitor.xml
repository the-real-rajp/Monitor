<!-- Small-host defaults. Raise these as the machine grows. -->
<clickhouse>
    <logger>
        <level>warning</level>
    </logger>
    <max_server_memory_usage_to_ram_ratio>0.7</max_server_memory_usage_to_ram_ratio>
    <mark_cache_size>1073741824</mark_cache_size>
    <!-- Keep the system log tables from eating the disk on a single node. -->
    <query_log>
        <ttl>event_date + INTERVAL 7 DAY</ttl>
    </query_log>
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <part_log remove="1"/>
</clickhouse>
