{
  "name": "monitor/web",
  "description": "Monitor website: JSON API, agent ingest, cron pinger and dashboard host",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-json": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": { "Monitor\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Monitor\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "find src bin public tests -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
