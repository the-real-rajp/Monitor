<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         cacheDirectory=".phpunit.cache">
  <testsuites>
    <testsuite name="monitor">
      <directory>tests</directory>
    </testsuite>
  </testsuites>
  <php>
    <!-- Override with a real environment variable in CI. -->
    <env name="MONITOR_TEST_DSN" value="mysql:host=127.0.0.1;dbname=monitor_test;charset=utf8mb4"/>
    <env name="MONITOR_TEST_USER" value="monitor"/>
    <env name="MONITOR_TEST_PASSWORD" value="monitor"/>
  </php>
</phpunit>
